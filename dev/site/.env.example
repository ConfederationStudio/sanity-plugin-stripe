# Copy to .env.local and fill in. Keys stay in .env.local, never in code.

# The Sanity project the test shop reads and the Studio at /studio edits.
# Leave it empty to sell sample products kept in memory (the Studio then has nothing to open).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# A restricted test key (rk_test_…) from a Stripe sandbox.
STRIPE_SECRET_KEY=
# The webhook signing secret (whsec_…) that `stripe listen` prints.
STRIPE_WEBHOOK_SECRET=
# Optional, to try a subscription's renewal: a customer (cus_…) made on a Stripe test clock. The
# checkout then buys as that customer, and moving the clock forward brings the renewal.
STRIPE_TEST_CUSTOMER=
# Optional: Stripe tax rates (txr_…) so receipts show the VAT. Prices already include it.
STRIPE_TAX_RATE_REDUCED=
STRIPE_TAX_RATE_STANDARD=

# A Sanity token with Editor rights. Stock counts are private, so the checkout needs it to read
# them and the webhook to lower them. Without it nothing is counted.
SANITY_API_WRITE_TOKEN=

# Where the order email would go. It is the site's own setting, never stored in Sanity.
ORDER_EMAIL_TO=
