# Copy to .env.local and fill in. Keys stay in .env.local, never in code.

# The Sanity project the test shop reads and the Studio at /studio edits.
# Leave it empty to sell sample products kept in memory (the Studio then has nothing to open).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# A restricted test key (rk_test_…) from a Stripe sandbox.
STRIPE_SECRET_KEY=
# The webhook signing secret (whsec_…) that `stripe listen` prints.
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe tax rates (txr_…) so receipts show the VAT. Prices already include it.
STRIPE_TAX_RATE_REDUCED=
STRIPE_TAX_RATE_STANDARD=

# A Sanity token with Editor rights, so paid orders lower stock counts. Without it stock is left alone.
SANITY_API_WRITE_TOKEN=
